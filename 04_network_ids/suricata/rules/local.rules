# Suricata Custom Rules for NIDS
# ============================================================
# Custom detection rules for common attack patterns
# SID Range: 1000000-1999999 reserved for local rules
# ============================================================

# ------------------------------------------------------------------------------
# Web Application Attacks
# ------------------------------------------------------------------------------

# SQL Injection - Union-based
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP SQL Injection Union Select";
    flow:to_server,established;
    content:"union"; nocase;
    content:"select"; nocase; distance:0; within:50;
    pcre:"/union\s+.*select/i";
    classtype:web-application-attack;
    reference:url,owasp.org/www-community/attacks/SQL_Injection;
    metadata:created_at 2024-01-15;
    sid:1000001; rev:2;
)

# SQL Injection - Error-based
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP SQL Injection Error Based";
    flow:to_server,established;
    pcre:"/(mysql|postgresql|oracle|sqlserver|syntax error|unclosed quotation)/i";
    classtype:web-application-attack;
    reference:url,owasp.org/www-community/attacks/SQL_Injection;
    sid:1000002; rev:2;
)

# SQL Injection - Blind/Time-based
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP SQL Injection Time Based";
    flow:to_server,established;
    pcre:"/(waitfor\s+delay|sleep\s*\(|benchmark\s*\(|pg_sleep\s*\()/i";
    classtype:web-application-attack;
    sid:1000003; rev:2;
)

# SQL Injection - Boolean-based
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP SQL Injection Boolean Based";
    flow:to_server,established;
    pcre:"/(or\s+1\s*=\s*1|and\s+1\s*=\s*1|or\s+'1'\s*=\s*'1|and\s+'1'\s*=\s*'1)/i";
    classtype:web-application-attack;
    sid:1000004; rev:1;
)

# Command Injection
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP Command Injection";
    flow:to_server,established;
    pcre:"/[;&|`\$\(\)]/";
    pcre:"/(cat|ls|id|whoami|uname|pwd|wget|curl|nc|bash|sh|python|perl|php)/i";
    classtype:web-application-attack;
    reference:url,owasp.org/www-community/attacks/Command_Injection;
    sid:1000005; rev:2;
)

# Path Traversal
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP Path Traversal";
    flow:to_server,established;
    pcre:"/(\.\.\/|\.\.\\|\%2e\%2e\/|\%2e\%2e\\))/i";
    classtype:web-application-attack;
    reference:url,owasp.org/www-community/attacks/Path_Traversal;
    sid:1000006; rev:2;
)

# XSS - Script Tag
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP XSS Script Tag";
    flow:to_server,established;
    content:"<script"; nocase;
    pcre:"/<script[^>]*>.*<\/script>/i";
    classtype:web-application-attack;
    reference:url,owasp.org/www-community/attacks/xss/;
    sid:1000007; rev:2;
)

# XSS - Event Handlers
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP XSS Event Handler";
    flow:to_server,established;
    pcre:"/on(load|error|click|mouseover|focus|blur|change|submit|keydown|keyup|keypress)\s*=/i";
    classtype:web-application-attack;
    sid:1000008; rev:1;
)

# XSS - JavaScript Protocol
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP XSS JavaScript Protocol";
    flow:to_server,established;
    content:"javascript:"; nocase;
    pcre:"/javascript\s*:/i";
    classtype:web-application-attack;
    sid:1000009; rev:1;
)

# LDAP Injection
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP LDAP Injection";
    flow:to_server,established;
    pcre:"/(\*|\(|\)|\||\&)/";
    content:"ldap"; nocase;
    classtype:web-application-attack;
    reference:url,owasp.org/www-community/attacks/LDAP_Injection;
    sid:1000010; rev:1;
)

# XXE Injection
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP XXE Injection";
    flow:to_server,established;
    content:"<!DOCTYPE"; nocase;
    content:"ENTITY"; nocase;
    content:"SYSTEM"; nocase;
    classtype:web-application-attack;
    reference:url,owasp.org/www-community/attacks/XML_External_Entity_(XXE)_Processing;
    sid:1000011; rev:1;
)

# SSRF Attempt
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-APP SSRF Attempt";
    flow:to_server,established;
    pcre:"/(http|https|ftp|gopher|dict|file|ldap)\s*:\s*\/\/(localhost|127\.0\.0\.1|169\.254\.169\.254|metadata\.google\.internal|metadata\.azure\.com|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2[0-9]|3[0-1])\.\d+\.\d+|192\.168\.\d+\.\d+)/i";
    classtype:web-application-attack;
    reference:url,owasp.org/www-community/attacks/Server_Side_Request_Forgery;
    sid:1000012; rev:2;
)

# ------------------------------------------------------------------------------
# Authentication Attacks
# ------------------------------------------------------------------------------

# Brute Force - SSH
alert ssh $EXTERNAL_NET any -> $HOME_NET $SSH_PORTS (
    msg:"BRUTE-FORCE SSH Authentication Failure";
    flow:to_server,established;
    ssh.proto_version: "2.0";
    ssh.auth_failed: 1;
    threshold: type both, track by_src, count 5, seconds 300;
    classtype:attempted-admin;
    reference:url,owasp.org/www-community/attacks/Brute_force;
    sid:1000101; rev:2;
)

# Brute Force - FTP
alert ftp $EXTERNAL_NET any -> $HOME_NET $FTP_PORTS (
    msg:"BRUTE-FORCE FTP Authentication Failure";
    flow:to_server,established;
    ftp.cmd: "PASS";
    ftp.response_code: 530;
    threshold: type both, track by_src, count 5, seconds 300;
    classtype:attempted-admin;
    sid:1000102; rev:1;
)

# Brute Force - HTTP Basic Auth
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"BRUTE-FORCE HTTP Basic Auth Failure";
    flow:to_server,established;
    http.response_code: 401;
    http.header_name: "WWW-Authenticate";
    content:"Basic"; nocase;
    threshold: type both, track by_src, count 10, seconds 300;
    classtype:attempted-admin;
    sid:1000103; rev:1;
)

# Brute Force - RDP
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (
    msg:"BRUTE-FORCE RDP Login Attempt";
    flow:to_server,established;
    content:"|03 00 00 0b 06 d0 00 00 12 34 00|";
    threshold: type both, track by_src, count 10, seconds 300;
    classtype:attempted-admin;
    sid:1000104; rev:1;
)

# Credential Stuffing - Multiple Users
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"CREDENTIAL-STUFFING Multiple Usernames";
    flow:to_server,established;
    http.uri; content:"/login"; nocase;
    http.header_name: "Content-Type";
    content:"application/x-www-form-urlencoded";
    threshold: type both, track by_src, count 20, seconds 300;
    classtype:attempted-admin;
    sid:1000105; rev:1;
)

# ------------------------------------------------------------------------------
# Malware & C2 Communications
# ------------------------------------------------------------------------------

# C2 Beaconing - Regular Intervals
alert http $HOME_NET any -> $EXTERNAL_NET any (
    msg:"MALWARE C2 HTTP Beaconing";
    flow:to_server,established;
    http.user_agent; content:"Mozilla"; nocase;
    threshold: type both, track by_src, count 20, seconds 300;
    classtype:trojan-activity;
    reference:url,attack.mitre.org/techniques/T1071/001/;
    sid:1000201; rev:2;
)

# DNS Tunneling
alert dns $HOME_NET any -> $EXTERNAL_NET any (
    msg:"MALWARE DNS Tunneling";
    dns.query;
    dns.query_length: >200;
    dns.query_type: TXT;
    threshold: type both, track by_src, count 50, seconds 300;
    classtype:trojan-activity;
    reference:url,attack.mitre.org/techniques/T1071/004/;
    sid:1000202; rev:2;
)

# Suspicious User Agent
alert http $HOME_NET any -> $EXTERNAL_NET any (
    msg:"MALWARE Suspicious User Agent";
    flow:to_server,established;
    http.user_agent;
    pcre:"/(python|perl|curl|wget|nmap|masscan|zmap|nikto|sqlmap|hydra|medusa|metasploit|msf|empire|koadic|poshc2|cobaltstrike|beacon|implant|rat|trojan|botnet|miner|xmrig)/i";
    classtype:trojan-activity;
    sid:1000203; rev:3;
)

